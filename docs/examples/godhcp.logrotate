# Enable only after configuring logging.output and preparing this directory.
/var/log/godhcp/godhcp.log {
    daily
    maxsize 100M
    rotate 14
    missingok
    notifempty
    compress
    delaycompress
    nodateext
    copytruncate
    su godhcp godhcp
}
